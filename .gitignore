# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
venv/
env/
.venv/
.env

# Data (large files - regenerate with scripts in src/data, don't commit)
data/raw/*
data/splits/*
!data/raw/.gitkeep
!data/splits/.gitkeep

# Cloned baseline repos (each has its own git history/license - don't nest them)
src/data/baselines/*
!src/data/baselines/README.md
!src/data/baselines/__init__.py
notebooks/data/

# Model checkpoints and generated results.
# Everything under results/ is regenerated, never committed. This is broader
# than listing extensions on purpose: the training loop and the ladder both
# write .json into results/, and a DUMMY_PLACEHOLDER file committed by accident
# is a placeholder number sitting in the repo looking like a finding.
*.pt
*.pth
*.ckpt
results/*
!results/.gitkeep

# OS/editor junk
.DS_Store
.vscode/
.idea/
*.swp

baselines/**/data/
baselines/**/dataset/
